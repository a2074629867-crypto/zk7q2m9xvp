{"id": "c1_0034", "idx": 34, "chapter": "Chapter One", "para": 25, "part": 0, "text": "‘I wouldn’t do any harm, there, why can’t I go?’", "words": 11, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wronged_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_loud_1", "emo_target": "委屈"}
{"id": "c1_0050", "idx": 50, "chapter": "Chapter One", "para": 37, "part": 0, "text": "‘There’s nobody to play cricket with.’", "words": 7, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wronged_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_loud_1", "emo_target": "委屈"}
{"id": "c1_0166", "idx": 166, "chapter": "Chapter One", "para": 101, "part": 0, "text": "‘I suppose you quarrelled with grandfather then.’", "words": 8, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0210", "idx": 210, "chapter": "Chapter Two", "para": 10, "part": 0, "text": "‘I’m quite all right. There isn’t anything wrong at all.’", "words": 11, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0246", "idx": 246, "chapter": "Chapter Two", "para": 24, "part": 0, "text": "‘Nothing, it’s nothing. It’s only a pebble.’", "words": 8, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c2_0265", "idx": 265, "chapter": "Chapter Two", "para": 37, "part": 0, "text": "‘That’s nothing. It’s only an old house.’", "words": 8, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_defiant_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_excited_1", "emo_target": "激动反抗"}
{"id": "c2_0274", "idx": 274, "chapter": "Chapter Two", "para": 44, "part": 0, "text": "‘Where did you live before?’", "words": 6, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0279", "idx": 279, "chapter": "Chapter Two", "para": 49, "part": 0, "text": "‘Yes – no. Well, it was in somebody’s house.’", "words": 9, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_soft_1", "emo_target": "紧张"}
{"id": "c2_0298", "idx": 298, "chapter": "Chapter Two", "para": 64, "part": 0, "text": "‘Do you remember your father?’", "words": 6, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0299", "idx": 299, "chapter": "Chapter Two", "para": 65, "part": 0, "text": "‘Oh, yes. Well – a bit. He was a pilot, once. He was in the Battle of Britain. I’ve got...’", "words": 20, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_soft_1", "emo_target": "紧张"}
{"id": "c2_0302", "idx": 302, "chapter": "Chapter Two", "para": 66, "part": 0, "text": "‘Is it a picture of him in the Battle?’", "words": 10, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0307", "idx": 307, "chapter": "Chapter Two", "para": 71, "part": 0, "text": "‘He was, he was’", "words": 4, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c2_0308", "idx": 308, "chapter": "Chapter Two", "para": 71, "part": 1, "text": "‘When did he die, then?’", "words": 6, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0309", "idx": 309, "chapter": "Chapter Two", "para": 72, "part": 0, "text": "‘Here’s the picture, look – that’s my father.’", "words": 8, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_wronged_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_excited_1", "emo_target": "委屈"}
{"id": "c2_0312", "idx": 312, "chapter": "Chapter Two", "para": 74, "part": 0, "text": "‘A few years ago. I was about five. Or six.’", "words": 11, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c2_0314", "idx": 314, "chapter": "Chapter Two", "para": 76, "part": 0, "text": "‘I don’t know. Quite old, I suppose. Look, then, there’s the photograph.’", "words": 13, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_excited_1", "emo_target": "紧张"}
{"id": "c2_0324", "idx": 324, "chapter": "Chapter Two", "para": 80, "part": 0, "text": "‘Where do you go to school?’", "words": 7, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0327", "idx": 327, "chapter": "Chapter Two", "para": 83, "part": 0, "text": "‘It’s called St Vincent’s.’", "words": 5, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_soft_1", "emo_target": "紧张"}
{"id": "c2_0328", "idx": 328, "chapter": "Chapter Two", "para": 84, "part": 0, "text": "‘Is it a proper school?’", "words": 6, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0365", "idx": 365, "chapter": "Chapter Two", "para": 104, "part": 0, "text": "‘Is your school a proper boarding school?’", "words": 8, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0368", "idx": 368, "chapter": "Chapter Two", "para": 107, "part": 0, "text": "‘I think... I don’t know. I think it’s free.’", "words": 10, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c2_0404", "idx": 404, "chapter": "Chapter Two", "para": 120, "part": 1, "text": "‘It is my window, now.’", "words": 6, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_defiant_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_soft_1", "emo_target": "激动反抗"}
{"id": "c2_0427", "idx": 427, "chapter": "Chapter Two", "para": 134, "part": 0, "text": "‘He might be anywhere. I don’t know where.’", "words": 9, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c2_0437", "idx": 437, "chapter": "Chapter Two", "para": 141, "part": 0, "text": "‘Oh. Are they going to stay, then?’", "words": 8, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_nervous_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_begging_1", "emo_target": "紧张"}
{"id": "c2_0487", "idx": 487, "chapter": "Chapter Two", "para": 172, "part": 0, "text": "‘What are you going back into the house for? I’ve seen all the house, haven’t I?’", "words": 17, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_wary_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "警惕"}
{"id": "c3_0637", "idx": 637, "chapter": "Chapter Three", "para": 41, "part": 0, "text": "‘Why did you go off, anyway? Where did you think you’d get to?’", "words": 14, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c3_0655", "idx": 655, "chapter": "Chapter Three", "para": 56, "part": 0, "text": "‘I don’t care if you believe me or not.’", "words": 10, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_defiant_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_excited_1", "emo_target": "激动反抗"}
{"id": "c3_0839", "idx": 839, "chapter": "Chapter Three", "para": 135, "part": 0, "text": "‘Who... where did they come from?’", "words": 7, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c3_0853", "idx": 853, "chapter": "Chapter Three", "para": 142, "part": 0, "text": "‘I – I can see them all right, can’t I?’", "words": 10, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c3_0861", "idx": 861, "chapter": "Chapter Three", "para": 150, "part": 0, "text": "‘Nothing. I don’t want to touch one, that’s all.’", "words": 10, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c3_0875", "idx": 875, "chapter": "Chapter Three", "para": 161, "part": 0, "text": "‘Why?’ Hooper was peering curiously into his face. ‘Why?’", "words": 11, "dialog": true, "speaker": "Edmund", "conf": "MANUAL", "voice": "Thomas_wary_1", "voice_base": "Thomas_calm_1", "voice_was": "Thomas_calm_1", "emo_target": "警惕"}
{"id": "c3_0876", "idx": 876, "chapter": "Chapter Three", "para": 162, "part": 0, "text": "‘You might damage it. If they’re valuable you’ll get into trouble, won't you?’", "words": 14, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_neutral_1", "emo_target": "紧张"}
{"id": "c3_0922", "idx": 922, "chapter": "Chapter Three", "para": 183, "part": 1, "text": "‘It’s O.K. I just got locked in. Goodnight,’ and raced for the stairs, before the questions could begin.", "words": 20, "dialog": true, "speaker": "Charles", "conf": "MANUAL", "voice": "Charles_nervous_1", "voice_base": "Charles_neutral_1", "voice_was": "Charles_soft_1", "emo_target": "紧张"}
